---
source: tests/mcp_server.rs
assertion_line: 40
expression: summary
---
- description: "Returns pressure stall information (PSI) for a cgroup or system-wide. PSI gives the percentage of time tasks were stalled waiting for memory, CPU, or IO over 10s/60s/300s rolling windows — distinguishing 'busy' from 'struggling.' Pass an empty path for the root (system-wide) cgroup, or a relative path like 'system.slice/nginx.service'. Returns three pressure stanzas (memory, cpu, io); each may be null if the controller is not enabled on the targeted cgroup."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      path:
        default: ""
        description: "Cgroup path relative to the configured cgroup root.\nUse the empty string `\"\"` for system-wide pressure (the root cgroup).\nExamples: `\"\"`, `\"system.slice\"`, `\"system.slice/nginx.service\"`.\nThe path must not be absolute and must not contain `..` segments."
        type: string
    title: GetPressureParams
    type: object
  name: get_pressure
  output_schema:
    $defs:
      Pressure:
        properties:
          full:
            anyOf:
              - $ref: "#/$defs/PressureLine"
              - type: "null"
          some:
            $ref: "#/$defs/PressureLine"
        required:
          - some
        type: object
      PressureLine:
        properties:
          avg10:
            format: double
            type: number
          avg300:
            format: double
            type: number
          avg60:
            format: double
            type: number
          total_usec:
            format: uint64
            minimum: 0
            type: integer
        required:
          - avg10
          - avg60
          - avg300
          - total_usec
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      cpu:
        anyOf:
          - $ref: "#/$defs/Pressure"
          - type: "null"
        description: "CPU pressure: time tasks were stalled waiting for CPU."
      io:
        anyOf:
          - $ref: "#/$defs/Pressure"
          - type: "null"
        description: "IO pressure: time tasks were stalled waiting for IO."
      memory:
        anyOf:
          - $ref: "#/$defs/Pressure"
          - type: "null"
        description: "Memory pressure: time tasks were stalled waiting for memory."
      path:
        description: Echoes the queried cgroup path so the agent can correlate the response.
        type: string
    required:
      - path
    title: GetPressureResponse
    type: object
- description: "Returns the full set of cgroup v2 stat files for a single cgroup, grouped into cpu, memory, and io sections. Each section contains the relevant stat counters and the pressure (PSI) for that controller. Use this to drill into a specific cgroup once you've identified it (e.g. via top_memory) — it answers 'what is this cgroup actually doing right now?' Memory.stat is returned as a raw key/value map so all kernel fields are available (anon, file, slab, kernel, sock, shmem, pgfault, oom_kill, etc.). Pass an empty path for the root cgroup, or a relative path like 'system.slice/nginx.service'. Individual fields are null when the corresponding file is absent (e.g. some cgroups don't expose memory.current; root cgroups vary by kernel)."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      path:
        default: ""
        description: "Cgroup path relative to the configured cgroup root.\nUse the empty string `\"\"` for the root cgroup. Examples: `\"\"`,\n`\"system.slice\"`, `\"system.slice/nginx.service\"`. The path must not\nbe absolute and must not contain `..` segments."
        type: string
    title: GetUnitStatsParams
    type: object
  name: get_unit_stats
  output_schema:
    $defs:
      CpuSection:
        properties:
          pressure:
            anyOf:
              - $ref: "#/$defs/Pressure"
              - type: "null"
            description: "PSI from `cpu.pressure`. Null if the controller is not enabled."
          stat:
            anyOf:
              - $ref: "#/$defs/CpuStat"
              - type: "null"
            description: "Cumulative CPU usage from `cpu.stat`. Values are monotonic counters in\nmicroseconds; subtract two snapshots to get a rate. Null if cpu\naccounting is not available on this cgroup."
        type: object
      CpuStat:
        properties:
          burst_usec:
            format: uint64
            minimum: 0
            type: integer
          nice_usec:
            format: uint64
            minimum: 0
            type: integer
          nr_bursts:
            format: uint64
            minimum: 0
            type: integer
          nr_periods:
            format: uint64
            minimum: 0
            type: integer
          nr_throttled:
            format: uint64
            minimum: 0
            type: integer
          system_usec:
            format: uint64
            minimum: 0
            type: integer
          throttled_usec:
            format: uint64
            minimum: 0
            type: integer
          usage_usec:
            format: uint64
            minimum: 0
            type: integer
          user_usec:
            format: uint64
            minimum: 0
            type: integer
        required:
          - usage_usec
          - user_usec
          - system_usec
          - nice_usec
          - nr_periods
          - nr_throttled
          - throttled_usec
          - nr_bursts
          - burst_usec
        type: object
      IoDeviceStat:
        properties:
          dbytes:
            format: uint64
            minimum: 0
            type: integer
          dios:
            format: uint64
            minimum: 0
            type: integer
          major:
            format: uint32
            minimum: 0
            type: integer
          minor:
            format: uint32
            minimum: 0
            type: integer
          rbytes:
            format: uint64
            minimum: 0
            type: integer
          rios:
            format: uint64
            minimum: 0
            type: integer
          wbytes:
            format: uint64
            minimum: 0
            type: integer
          wios:
            format: uint64
            minimum: 0
            type: integer
        required:
          - major
          - minor
          - rbytes
          - wbytes
          - rios
          - wios
          - dbytes
          - dios
        type: object
      IoSection:
        properties:
          pressure:
            anyOf:
              - $ref: "#/$defs/Pressure"
              - type: "null"
            description: "PSI from `io.pressure`. Null if the controller is not enabled."
          stat:
            description: "Per-device IO counters from `io.stat`. Null if the IO controller is\nnot enabled on this cgroup."
            items:
              $ref: "#/$defs/IoDeviceStat"
            type:
              - array
              - "null"
        type: object
      MemoryEvents:
        properties:
          high:
            format: uint64
            minimum: 0
            type: integer
          low:
            format: uint64
            minimum: 0
            type: integer
          max:
            format: uint64
            minimum: 0
            type: integer
          oom:
            format: uint64
            minimum: 0
            type: integer
          oom_group_kill:
            format: uint64
            minimum: 0
            type: integer
          oom_kill:
            format: uint64
            minimum: 0
            type: integer
        required:
          - low
          - high
          - max
          - oom
          - oom_kill
          - oom_group_kill
        type: object
      MemorySection:
        properties:
          current_bytes:
            description: "Current resident memory in bytes from `memory.current`. For slices\nand the root, this is summed across descendants. Null if memory\naccounting is not available (e.g. on the root cgroup of some\nkernels)."
            format: uint64
            minimum: 0
            type:
              - integer
              - "null"
          events:
            anyOf:
              - $ref: "#/$defs/MemoryEvents"
              - type: "null"
            description: "OOM and limit-event counters from `memory.events`. Cumulative since\nthe cgroup was created. Null if the file is absent."
          pressure:
            anyOf:
              - $ref: "#/$defs/Pressure"
              - type: "null"
            description: "PSI from `memory.pressure`. Null if the controller is not enabled."
          stat:
            anyOf:
              - $ref: "#/$defs/MemoryStat"
              - type: "null"
            description: "Full `memory.stat` as a map of kernel field name to value (bytes for\nmost fields, counts for fault-style fields). The set of keys depends\non kernel version; common ones include `anon`, `file`, `kernel`,\n`slab`, `sock`, `shmem`, `pgfault`, `pgmajfault`. Null if the file\nis absent."
        type: object
      MemoryStat:
        properties:
          raw:
            additionalProperties:
              format: uint64
              minimum: 0
              type: integer
            type: object
        required:
          - raw
        type: object
      Pressure:
        properties:
          full:
            anyOf:
              - $ref: "#/$defs/PressureLine"
              - type: "null"
          some:
            $ref: "#/$defs/PressureLine"
        required:
          - some
        type: object
      PressureLine:
        properties:
          avg10:
            format: double
            type: number
          avg300:
            format: double
            type: number
          avg60:
            format: double
            type: number
          total_usec:
            format: uint64
            minimum: 0
            type: integer
        required:
          - avg10
          - avg60
          - avg300
          - total_usec
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      cpu:
        $ref: "#/$defs/CpuSection"
        description: CPU accounting and pressure for this cgroup.
      io:
        $ref: "#/$defs/IoSection"
        description: IO accounting (per-device) and pressure for this cgroup.
      memory:
        $ref: "#/$defs/MemorySection"
        description: "Memory accounting, events, and pressure for this cgroup."
      path:
        description: Echoes the queried cgroup path.
        type: string
    required:
      - path
      - cpu
      - memory
      - io
    title: GetUnitStatsResponse
    type: object
- description: "Walks a cgroup subtree and returns every cgroup whose memory.events.local has at least one non-zero counter (low, high, max, oom, oom_kill, oom_group_kill). Reads .local rather than memory.events so a slice doesn't appear OOMed when the actual kill happened in a child. IMPORTANT: counters are CUMULATIVE since the cgroup was created — they have no timestamp and no rolling window. A non-zero count means 'this happened at some point,' not 'this happened recently.' Do not tell the user something 'just' OOMed based on this output. Pass an empty path for the whole tree, or a relative path like 'system.slice' to scope the search. By default returns only cgroups with at least one non-zero counter; pass include_zero=true to confirm 'nothing has OOMed.' Results are sorted by oom_kill desc, then oom desc."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      include_zero:
        default: ~
        description: "If true, include cgroups whose counters are all zero. Defaults to\nfalse: returning only cgroups that have actually hit a memory event\nkeeps the response focused. Set to true if you want to confirm\n\"nothing has OOMed\" or to walk the full tree for some other reason."
        type:
          - boolean
          - "null"
      path:
        default: ""
        description: "Subtree to search under, relative to the cgroup root. Use the empty\nstring `\"\"` to search the whole tree. Examples: `\"\"`,\n`\"system.slice\"`, `\"user.slice\"`. The path must not be absolute and\nmust not contain `..` segments."
        type: string
    title: RecentOomEventsParams
    type: object
  name: recent_oom_events
  output_schema:
    $defs:
      CgroupKind:
        oneOf:
          - enum:
              - root
              - slice
              - service
              - scope
              - mount
              - socket
            type: string
          - additionalProperties: false
            properties:
              other:
                type: string
            required:
              - other
            type: object
      MemoryEvents:
        properties:
          high:
            format: uint64
            minimum: 0
            type: integer
          low:
            format: uint64
            minimum: 0
            type: integer
          max:
            format: uint64
            minimum: 0
            type: integer
          oom:
            format: uint64
            minimum: 0
            type: integer
          oom_group_kill:
            format: uint64
            minimum: 0
            type: integer
          oom_kill:
            format: uint64
            minimum: 0
            type: integer
        required:
          - low
          - high
          - max
          - oom
          - oom_kill
          - oom_group_kill
        type: object
      OomEventEntry:
        properties:
          events:
            $ref: "#/$defs/MemoryEvents"
            description: "Counters from `memory.events.local` for this cgroup. Cumulative\nsince the cgroup was created — no timestamp, no rolling window."
          kind:
            $ref: "#/$defs/CgroupKind"
            description: Cgroup kind.
          path:
            description: "Path relative to the cgroup root, e.g. `system.slice/nginx.service`."
            type: string
        required:
          - path
          - kind
          - events
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      results:
        description: "Matching cgroups, sorted by `oom_kill` desc, then `oom` desc, then\n`oom_group_kill`, `high`, `low` as tiebreakers."
        items:
          $ref: "#/$defs/OomEventEntry"
        type: array
      subtree:
        description: Echoes the queried subtree path.
        type: string
    required:
      - subtree
      - results
    title: RecentOomEventsResponse
    type: object
- description: "Returns the cgroups using the most CPU under a given subtree, sorted descending by CPU time consumed during a sampling window. Use this to answer 'what's using the most CPU.' UNLIKE other tools in this server, this one BLOCKS for the duration of the sample window (default 500ms) — it reads cpu.stat once, sleeps, and reads again to compute a rate. Shorter windows respond faster but become noisy below ~50ms; longer windows are more stable but slower. Each entry returns CPU consumption as both `usage_cores` (1.0 = one full core for the whole window) and `usage_delta_usec` (raw microseconds). Throttle counters are also returned per entry — non-zero `throttled_periods_delta` means the cgroup wanted more CPU but hit its limit. Pass an empty path for the whole tree, or a relative path like 'system.slice'. Slices and the root cgroup are excluded from results because their cpu.stat shows summed descendant time, not actual leaf consumers. Default n is 10."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      n:
        default: ~
        description: "Number of top consumers to return. Defaults to 10. Slices and the\nroot cgroup are always excluded — their cpu.stat is summed across\ndescendants and would dominate the ranking without representing\nactual leaf consumers."
        format: uint
        minimum: 0
        type:
          - integer
          - "null"
      path:
        default: ""
        description: "Subtree to search under, relative to the cgroup root. Use the empty\nstring `\"\"` to search the whole tree. Examples: `\"\"`,\n`\"system.slice\"`, `\"user.slice\"`. The path must not be absolute and\nmust not contain `..` segments."
        type: string
      sample_window_ms:
        default: ~
        description: "Sample window in milliseconds. The tool blocks for this long while\nit reads cpu.stat twice (before and after) to compute a rate.\nDefaults to 500. Lower values respond faster but become noisy:\nkernel CPU accounting updates on context switches and timer ticks,\nso windows under ~50ms are dominated by quantization. Bursty\nworkloads also alias badly under short windows. Higher values\nimprove stability at the cost of agent latency."
        format: uint64
        minimum: 0
        type:
          - integer
          - "null"
    title: TopCpuParams
    type: object
  name: top_cpu
  output_schema:
    $defs:
      CgroupKind:
        oneOf:
          - enum:
              - root
              - slice
              - service
              - scope
              - mount
              - socket
            type: string
          - additionalProperties: false
            properties:
              other:
                type: string
            required:
              - other
            type: object
      TopCpuEntry:
        properties:
          kind:
            $ref: "#/$defs/CgroupKind"
            description: "Cgroup kind (typically `service` or `scope`; `slice` and `root` are\nexcluded by this tool)."
          path:
            description: "Path relative to the cgroup root, e.g. `system.slice/nginx.service`."
            type: string
          reset_detected:
            description: "True if any counter went backwards between snapshots — typically a\ncgroup recreation (service restart). All rate fields are 0 when\nthis is set."
            type: boolean
          system_cores:
            description: Kernel-mode CPU as a fraction of cores during the window.
            format: double
            type: number
          throttled_periods_delta:
            description: "Number of times the cgroup's CPU bandwidth limit fired during the\nwindow (delta of cpu.stat nr_throttled). Non-zero means the cgroup\nis hitting its limit; combine with `usage_cores` to distinguish\n\"wants more CPU but capped\" from \"just has high demand.\""
            format: uint64
            minimum: 0
            type: integer
          throttled_usec_delta:
            description: "Total time the cgroup spent throttled during the window\n(delta of cpu.stat throttled_usec)."
            format: uint64
            minimum: 0
            type: integer
          usage_cores:
            description: "CPU consumed during the sample window, expressed in cores. 1.0 = one\nfull core saturated for the whole window. Can exceed 1.0 on\nmulti-core systems."
            format: double
            type: number
          usage_delta_usec:
            description: "Same data as `usage_cores`, raw. Microseconds of CPU time consumed\nduring the window (delta of cpu.stat usage_usec)."
            format: uint64
            minimum: 0
            type: integer
          user_cores:
            description: User-mode CPU as a fraction of cores during the window.
            format: double
            type: number
        required:
          - path
          - kind
          - usage_cores
          - usage_delta_usec
          - user_cores
          - system_cores
          - throttled_periods_delta
          - throttled_usec_delta
          - reset_detected
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      results:
        description: "Top consumers, sorted descending by `usage_delta_usec`."
        items:
          $ref: "#/$defs/TopCpuEntry"
        type: array
      sample_window_ms:
        description: "Actual sample window used, in milliseconds."
        format: uint64
        minimum: 0
        type: integer
      subtree:
        description: Echoes the queried subtree path.
        type: string
    required:
      - subtree
      - sample_window_ms
      - results
    title: TopCpuResponse
    type: object
- description: "Returns the cgroups doing the most disk IO under a given subtree, sorted descending by total bytes/sec (read + write) consumed during a sampling window. Use this to answer 'what's hammering disk.' Like top_cpu, this tool BLOCKS for the duration of the sample window (default 500ms): it reads io.stat once, sleeps, and reads again to compute rates. Same tradeoff: shorter windows respond faster but become noisy on bursty IO; longer windows are more stable. Each entry returns aggregate rates (total_bytes_per_sec, rbytes_per_sec, wbytes_per_sec, total_ios_per_sec, rios_per_sec, wios_per_sec) summed across all block devices, plus a per_device array for cases where one cgroup is hammering one disk but quiet elsewhere. Pass an empty path for the whole tree, or a relative path like 'system.slice'. Slices and the root cgroup are excluded from results because their io.stat is summed across descendants. Default n is 10. Cgroups without an enabled IO controller are silently skipped."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      n:
        default: ~
        description: "Number of top consumers to return. Defaults to 10. Slices and the\nroot cgroup are always excluded since their io.stat is summed\nacross descendants."
        format: uint
        minimum: 0
        type:
          - integer
          - "null"
      path:
        default: ""
        description: "Subtree to search under, relative to the cgroup root. Use the empty\nstring `\"\"` to search the whole tree. Examples: `\"\"`,\n`\"system.slice\"`, `\"user.slice\"`. The path must not be absolute and\nmust not contain `..` segments."
        type: string
      sample_window_ms:
        default: ~
        description: "Sample window in milliseconds. The tool blocks for this long while\nit reads io.stat twice (before and after) to compute rates.\nDefaults to 500. Same tradeoff as top_cpu: lower values respond\nfaster but become noisy on bursty IO; higher values smooth out at\nthe cost of agent latency."
        format: uint64
        minimum: 0
        type:
          - integer
          - "null"
    title: TopIoParams
    type: object
  name: top_io
  output_schema:
    $defs:
      CgroupKind:
        oneOf:
          - enum:
              - root
              - slice
              - service
              - scope
              - mount
              - socket
            type: string
          - additionalProperties: false
            properties:
              other:
                type: string
            required:
              - other
            type: object
      TopIoDeviceRate:
        properties:
          dbytes_per_sec:
            description: Discard bytes (TRIM/discard) per second.
            format: double
            type: number
          dios_per_sec:
            format: double
            type: number
          major:
            description: "Device major number from `io.stat` line."
            format: uint32
            minimum: 0
            type: integer
          minor:
            description: "Device minor number from `io.stat` line."
            format: uint32
            minimum: 0
            type: integer
          rbytes_per_sec:
            format: double
            type: number
          reset_detected:
            description: True if any counter on this device went backwards.
            type: boolean
          rios_per_sec:
            format: double
            type: number
          wbytes_per_sec:
            format: double
            type: number
          wios_per_sec:
            format: double
            type: number
        required:
          - major
          - minor
          - rbytes_per_sec
          - wbytes_per_sec
          - rios_per_sec
          - wios_per_sec
          - dbytes_per_sec
          - dios_per_sec
          - reset_detected
        type: object
      TopIoEntry:
        properties:
          kind:
            $ref: "#/$defs/CgroupKind"
            description: "Cgroup kind (typically `service` or `scope`; `slice` and `root` are\nexcluded by this tool)."
          path:
            description: "Path relative to the cgroup root, e.g. `system.slice/nginx.service`."
            type: string
          per_device:
            description: "Per-device breakdown. Useful when one cgroup is hammering a single\ndevice but quiet elsewhere; agents asking \"what's hammering disk\noverall\" can ignore this and read the totals."
            items:
              $ref: "#/$defs/TopIoDeviceRate"
            type: array
          rbytes_per_sec:
            description: "Read bytes per second, summed across devices."
            format: double
            type: number
          reset_detected:
            description: "True if any counter went backwards on any device, typically due to\na cgroup recreation. The aggregate rate fields are 0.0 when this\nis set; per-device entries flag the same condition individually."
            type: boolean
          rios_per_sec:
            description: "Read IOPS, summed across devices."
            format: double
            type: number
          total_bytes_per_sec:
            description: "Read+write bytes per second across all block devices, derived from\n`io.stat` deltas over the sample window. This is the headline rank\nfield."
            format: double
            type: number
          total_ios_per_sec:
            description: Read+write IOPS across all devices.
            format: double
            type: number
          wbytes_per_sec:
            description: "Write bytes per second, summed across devices."
            format: double
            type: number
          wios_per_sec:
            description: "Write IOPS, summed across devices."
            format: double
            type: number
        required:
          - path
          - kind
          - total_bytes_per_sec
          - rbytes_per_sec
          - wbytes_per_sec
          - total_ios_per_sec
          - rios_per_sec
          - wios_per_sec
          - per_device
          - reset_detected
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      results:
        description: "Top consumers, sorted descending by `total_bytes_per_sec`."
        items:
          $ref: "#/$defs/TopIoEntry"
        type: array
      sample_window_ms:
        description: "Actual sample window used, in milliseconds."
        format: uint64
        minimum: 0
        type: integer
      subtree:
        description: Echoes the queried subtree path.
        type: string
    required:
      - subtree
      - sample_window_ms
      - results
    title: TopIoResponse
    type: object
- description: "Returns the cgroups using the most memory right now under a given subtree, sorted descending by memory.current bytes. Use this to answer 'what's using the most memory.' Pass an empty path for the whole tree, or a relative path like 'system.slice' or 'user.slice' to scope the search. Slices and the root cgroup are excluded from results because their memory.current shows summed descendant memory, not actual leaf consumers. Default n is 10."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      n:
        default: ~
        description: "Number of top consumers to return. Defaults to 10. Slices and the\nroot cgroup are always excluded — their memory.current shows the\nsummed memory of all descendants, which would dominate the ranking\nwithout representing actual leaf consumers."
        format: uint
        minimum: 0
        type:
          - integer
          - "null"
      path:
        default: ""
        description: "Subtree to search under, relative to the cgroup root. Use the empty\nstring `\"\"` to search the whole tree. Examples: `\"\"`,\n`\"system.slice\"`, `\"user.slice\"`. The path must not be absolute and\nmust not contain `..` segments."
        type: string
    title: TopMemoryParams
    type: object
  name: top_memory
  output_schema:
    $defs:
      CgroupKind:
        oneOf:
          - enum:
              - root
              - slice
              - service
              - scope
              - mount
              - socket
            type: string
          - additionalProperties: false
            properties:
              other:
                type: string
            required:
              - other
            type: object
      TopMemoryEntry:
        properties:
          kind:
            $ref: "#/$defs/CgroupKind"
            description: "Cgroup kind (typically `service` or `scope`; `slice` and `root` are\nexcluded by this tool)."
          memory_current_bytes:
            description: "Current resident memory in bytes (`memory.current`)."
            format: uint64
            minimum: 0
            type: integer
          path:
            description: "Path relative to the cgroup root, e.g. `system.slice/nginx.service`."
            type: string
        required:
          - path
          - kind
          - memory_current_bytes
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      results:
        description: "Top consumers, sorted descending by `memory_current_bytes`."
        items:
          $ref: "#/$defs/TopMemoryEntry"
        type: array
      subtree:
        description: Echoes the queried subtree path.
        type: string
    required:
      - subtree
      - results
    title: TopMemoryResponse
    type: object
