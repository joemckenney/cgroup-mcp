---
source: tests/mcp_server.rs
assertion_line: 35
expression: summary
---
- description: "Returns pressure stall information (PSI) for a cgroup or system-wide. PSI gives the percentage of time tasks were stalled waiting for memory, CPU, or IO over 10s/60s/300s rolling windows — distinguishing 'busy' from 'struggling.' Pass an empty path for the root (system-wide) cgroup, or a relative path like 'system.slice/nginx.service'. Returns three pressure stanzas (memory, cpu, io); each may be null if the controller is not enabled on the targeted cgroup."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      path:
        default: ""
        description: "Cgroup path relative to the configured cgroup root.\nUse the empty string `\"\"` for system-wide pressure (the root cgroup).\nExamples: `\"\"`, `\"system.slice\"`, `\"system.slice/nginx.service\"`.\nThe path must not be absolute and must not contain `..` segments."
        type: string
    title: GetPressureParams
    type: object
  name: get_pressure
  output_schema:
    $defs:
      Pressure:
        properties:
          full:
            anyOf:
              - $ref: "#/$defs/PressureLine"
              - type: "null"
          some:
            $ref: "#/$defs/PressureLine"
        required:
          - some
        type: object
      PressureLine:
        properties:
          avg10:
            format: double
            type: number
          avg300:
            format: double
            type: number
          avg60:
            format: double
            type: number
          total_usec:
            format: uint64
            minimum: 0
            type: integer
        required:
          - avg10
          - avg60
          - avg300
          - total_usec
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      cpu:
        anyOf:
          - $ref: "#/$defs/Pressure"
          - type: "null"
        description: "CPU pressure: time tasks were stalled waiting for CPU."
      io:
        anyOf:
          - $ref: "#/$defs/Pressure"
          - type: "null"
        description: "IO pressure: time tasks were stalled waiting for IO."
      memory:
        anyOf:
          - $ref: "#/$defs/Pressure"
          - type: "null"
        description: "Memory pressure: time tasks were stalled waiting for memory."
      path:
        description: Echoes the queried cgroup path so the agent can correlate the response.
        type: string
    required:
      - path
    title: GetPressureResponse
    type: object
- description: "Returns the full set of cgroup v2 stat files for a single cgroup, grouped into cpu, memory, and io sections. Each section contains the relevant stat counters and the pressure (PSI) for that controller. Use this to drill into a specific cgroup once you've identified it (e.g. via top_memory) — it answers 'what is this cgroup actually doing right now?' Memory.stat is returned as a raw key/value map so all kernel fields are available (anon, file, slab, kernel, sock, shmem, pgfault, oom_kill, etc.). Pass an empty path for the root cgroup, or a relative path like 'system.slice/nginx.service'. Individual fields are null when the corresponding file is absent (e.g. some cgroups don't expose memory.current; root cgroups vary by kernel)."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      path:
        default: ""
        description: "Cgroup path relative to the configured cgroup root.\nUse the empty string `\"\"` for the root cgroup. Examples: `\"\"`,\n`\"system.slice\"`, `\"system.slice/nginx.service\"`. The path must not\nbe absolute and must not contain `..` segments."
        type: string
    title: GetUnitStatsParams
    type: object
  name: get_unit_stats
  output_schema:
    $defs:
      CpuSection:
        properties:
          pressure:
            anyOf:
              - $ref: "#/$defs/Pressure"
              - type: "null"
            description: "PSI from `cpu.pressure`. Null if the controller is not enabled."
          stat:
            anyOf:
              - $ref: "#/$defs/CpuStat"
              - type: "null"
            description: "Cumulative CPU usage from `cpu.stat`. Values are monotonic counters in\nmicroseconds; subtract two snapshots to get a rate. Null if cpu\naccounting is not available on this cgroup."
        type: object
      CpuStat:
        properties:
          burst_usec:
            format: uint64
            minimum: 0
            type: integer
          nice_usec:
            format: uint64
            minimum: 0
            type: integer
          nr_bursts:
            format: uint64
            minimum: 0
            type: integer
          nr_periods:
            format: uint64
            minimum: 0
            type: integer
          nr_throttled:
            format: uint64
            minimum: 0
            type: integer
          system_usec:
            format: uint64
            minimum: 0
            type: integer
          throttled_usec:
            format: uint64
            minimum: 0
            type: integer
          usage_usec:
            format: uint64
            minimum: 0
            type: integer
          user_usec:
            format: uint64
            minimum: 0
            type: integer
        required:
          - usage_usec
          - user_usec
          - system_usec
          - nice_usec
          - nr_periods
          - nr_throttled
          - throttled_usec
          - nr_bursts
          - burst_usec
        type: object
      IoDeviceStat:
        properties:
          dbytes:
            format: uint64
            minimum: 0
            type: integer
          dios:
            format: uint64
            minimum: 0
            type: integer
          major:
            format: uint32
            minimum: 0
            type: integer
          minor:
            format: uint32
            minimum: 0
            type: integer
          rbytes:
            format: uint64
            minimum: 0
            type: integer
          rios:
            format: uint64
            minimum: 0
            type: integer
          wbytes:
            format: uint64
            minimum: 0
            type: integer
          wios:
            format: uint64
            minimum: 0
            type: integer
        required:
          - major
          - minor
          - rbytes
          - wbytes
          - rios
          - wios
          - dbytes
          - dios
        type: object
      IoSection:
        properties:
          pressure:
            anyOf:
              - $ref: "#/$defs/Pressure"
              - type: "null"
            description: "PSI from `io.pressure`. Null if the controller is not enabled."
          stat:
            description: "Per-device IO counters from `io.stat`. Null if the IO controller is\nnot enabled on this cgroup."
            items:
              $ref: "#/$defs/IoDeviceStat"
            type:
              - array
              - "null"
        type: object
      MemoryEvents:
        properties:
          high:
            format: uint64
            minimum: 0
            type: integer
          low:
            format: uint64
            minimum: 0
            type: integer
          max:
            format: uint64
            minimum: 0
            type: integer
          oom:
            format: uint64
            minimum: 0
            type: integer
          oom_group_kill:
            format: uint64
            minimum: 0
            type: integer
          oom_kill:
            format: uint64
            minimum: 0
            type: integer
        required:
          - low
          - high
          - max
          - oom
          - oom_kill
          - oom_group_kill
        type: object
      MemorySection:
        properties:
          current_bytes:
            description: "Current resident memory in bytes from `memory.current`. For slices\nand the root, this is summed across descendants. Null if memory\naccounting is not available (e.g. on the root cgroup of some\nkernels)."
            format: uint64
            minimum: 0
            type:
              - integer
              - "null"
          events:
            anyOf:
              - $ref: "#/$defs/MemoryEvents"
              - type: "null"
            description: "OOM and limit-event counters from `memory.events`. Cumulative since\nthe cgroup was created. Null if the file is absent."
          pressure:
            anyOf:
              - $ref: "#/$defs/Pressure"
              - type: "null"
            description: "PSI from `memory.pressure`. Null if the controller is not enabled."
          stat:
            anyOf:
              - $ref: "#/$defs/MemoryStat"
              - type: "null"
            description: "Full `memory.stat` as a map of kernel field name to value (bytes for\nmost fields, counts for fault-style fields). The set of keys depends\non kernel version; common ones include `anon`, `file`, `kernel`,\n`slab`, `sock`, `shmem`, `pgfault`, `pgmajfault`. Null if the file\nis absent."
        type: object
      MemoryStat:
        properties:
          raw:
            additionalProperties:
              format: uint64
              minimum: 0
              type: integer
            type: object
        required:
          - raw
        type: object
      Pressure:
        properties:
          full:
            anyOf:
              - $ref: "#/$defs/PressureLine"
              - type: "null"
          some:
            $ref: "#/$defs/PressureLine"
        required:
          - some
        type: object
      PressureLine:
        properties:
          avg10:
            format: double
            type: number
          avg300:
            format: double
            type: number
          avg60:
            format: double
            type: number
          total_usec:
            format: uint64
            minimum: 0
            type: integer
        required:
          - avg10
          - avg60
          - avg300
          - total_usec
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      cpu:
        $ref: "#/$defs/CpuSection"
        description: CPU accounting and pressure for this cgroup.
      io:
        $ref: "#/$defs/IoSection"
        description: IO accounting (per-device) and pressure for this cgroup.
      memory:
        $ref: "#/$defs/MemorySection"
        description: "Memory accounting, events, and pressure for this cgroup."
      path:
        description: Echoes the queried cgroup path.
        type: string
    required:
      - path
      - cpu
      - memory
      - io
    title: GetUnitStatsResponse
    type: object
- description: "Returns the cgroups using the most memory right now under a given subtree, sorted descending by memory.current bytes. Use this to answer 'what's using the most memory.' Pass an empty path for the whole tree, or a relative path like 'system.slice' or 'user.slice' to scope the search. Slices and the root cgroup are excluded from results because their memory.current shows summed descendant memory, not actual leaf consumers. Default n is 10."
  input_schema:
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      n:
        default: ~
        description: "Number of top consumers to return. Defaults to 10. Slices and the\nroot cgroup are always excluded — their memory.current shows the\nsummed memory of all descendants, which would dominate the ranking\nwithout representing actual leaf consumers."
        format: uint
        minimum: 0
        type:
          - integer
          - "null"
      path:
        default: ""
        description: "Subtree to search under, relative to the cgroup root. Use the empty\nstring `\"\"` to search the whole tree. Examples: `\"\"`,\n`\"system.slice\"`, `\"user.slice\"`. The path must not be absolute and\nmust not contain `..` segments."
        type: string
    title: TopMemoryParams
    type: object
  name: top_memory
  output_schema:
    $defs:
      CgroupKind:
        oneOf:
          - enum:
              - root
              - slice
              - service
              - scope
              - mount
              - socket
            type: string
          - additionalProperties: false
            properties:
              other:
                type: string
            required:
              - other
            type: object
      TopMemoryEntry:
        properties:
          kind:
            $ref: "#/$defs/CgroupKind"
            description: "Cgroup kind (typically `service` or `scope`; `slice` and `root` are\nexcluded by this tool)."
          memory_current_bytes:
            description: "Current resident memory in bytes (`memory.current`)."
            format: uint64
            minimum: 0
            type: integer
          path:
            description: "Path relative to the cgroup root, e.g. `system.slice/nginx.service`."
            type: string
        required:
          - path
          - kind
          - memory_current_bytes
        type: object
    $schema: "https://json-schema.org/draft/2020-12/schema"
    properties:
      results:
        description: "Top consumers, sorted descending by `memory_current_bytes`."
        items:
          $ref: "#/$defs/TopMemoryEntry"
        type: array
      subtree:
        description: Echoes the queried subtree path.
        type: string
    required:
      - subtree
      - results
    title: TopMemoryResponse
    type: object
